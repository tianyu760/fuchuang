# ============================================================
# Server environment template
# Copy this file to .env and fill real values
# ============================================================

# Contact mail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_authorization_code
CONTACT_PORT=3001

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Tencent Yuanqi
YUANQI_API_KEY=your_yuanqi_api_key
YUANQI_ASSISTANT_ID=your_yuanqi_assistant_id

# Tencent OCR
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_OCR_REGION=ap-beijing
